# Supabase project settings — safe browser values only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. Without this key, PageSpeed evidence is skipped rather than fabricated.
PAGESPEED_API_KEY=your-google-pagespeed-key

# Server-only xAI credentials for the planned Grok evidence-assessment step.
# Never prefix this key with NEXT_PUBLIC_ or commit a real value.
XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-4.7
